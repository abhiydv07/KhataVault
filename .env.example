# KhataVault Environment Configuration

# Supabase (Account and Subscription metadata only - Zero financial records stored)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Cloud OAuth 2.0 (drive.appdata sandbox scope)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Razorpay Subscriptions & UPI AutoPay (Key ID from Razorpay Dashboard)
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Optional: Configurable Subscription Pricing in INR (defaults to 299 & 2499)
VITE_MONTHLY_PRICE_INR=299
VITE_YEARLY_PRICE_INR=2499

